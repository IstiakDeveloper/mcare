{
    "id": "/",
    "name": "M Care",
    "short_name": "Mcare",
    "description": "Health staff activity, reporting, and field operations hub.",
    "lang": "en",
    "dir": "ltr",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "browser"],
    "orientation": "any",
    "background_color": "#f7fbf8",
    "theme_color": "#059669",
    "categories": ["health", "medical", "productivity"],
    "prefer_related_applications": false,
    "launch_handler": {
        "client_mode": ["navigate-existing", "auto"]
    },
    "icons": [
        {
            "src": "/icons/icon-32.png",
            "sizes": "32x32",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Dashboard",
            "short_name": "Today",
            "description": "Open today's field dashboard",
            "url": "/dashboard",
            "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
        },
        {
            "name": "Activities",
            "short_name": "Activities",
            "description": "Review submitted field activities",
            "url": "/activities",
            "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
        },
        {
            "name": "Health Camps",
            "short_name": "Camps",
            "description": "Open health camp records",
            "url": "/health-camps",
            "icons": [{ "src": "/icons/icon-96.png", "sizes": "96x96" }]
        }
    ]
}
